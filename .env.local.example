# =====================================================
# Ingrow LMS — 환경변수 예시 파일
# 실제 값은 .env.local 에 채워서 사용. (.env.local 은 git 미포함)
# 운영 (Vercel) 은 동일 키를 Project Settings → Environment Variables 에 등록.
# =====================================================

# ─── Supabase (필수) ─────────────────────────────────────
# Supabase Dashboard > Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service Role Key — 서버 사이드 RLS 우회용. NEVER 클라이언트 노출.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── 앱 URL (필수) ───────────────────────────────────────
# 로컬: http://localhost:3000   /   운영: https://your-domain.com
# Stripe success/cancel URL, 이메일 본문 link 등에 사용.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Stripe (Phase 2 결제 활성 / Phase 6 영상강좌 결제) ────
# https://dashboard.stripe.com/apikeys
# 테스트 모드 키 (sk_test_...) 로 시작 권장.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# 온라인 강좌 webhook (/api/payments/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...
# 오프라인 신청 webhook (/api/offline/webhook) — 별도 endpoint 등록 시.
# 미설정 시 STRIPE_WEBHOOK_SECRET fallback.
STRIPE_OFFLINE_WEBHOOK_SECRET=whsec_...

# ─── 이메일 발송 (Resend) ────────────────────────────────
# https://resend.com 에서 API 키 발급 + 도메인 검증
# 미설정 시 메일 발송이 자동 skip 처리 (앱은 정상 동작, notification_logs 에 'skipped' 기록)
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=noreply@your-domain.com

# ─── Cron 인증 (Vercel Cron) ─────────────────────────────
# vercel.json 의 cron 엔드포인트 보호용. 헤더 'authorization: Bearer <CRON_SECRET>' 검증.
# 운영에서는 반드시 강력한 random secret 사용. 로컬 dev 에선 임의 값 OK.
CRON_SECRET=set-strong-random-secret-here

# ─── 에러 추적 (Sentry — Phase F 예정) ──────────────────
# https://sentry.io 프로젝트 생성 후 DSN / Auth Token 발급.
# 미설정 시 Sentry 비활성 (앱은 정상 동작, 콘솔 로그만 사용).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# 운영 환경 구분용 (production / preview / development)
SENTRY_ENVIRONMENT=development
# Source map 업로드 시 사용 (Sentry org / project slug)
SENTRY_ORG=
SENTRY_PROJECT=

# ─── (Phase 6 예정) 카카오 알림톡 ────────────────────────
# 비즈메시지 사업자 등록 후 사용. MVP 단계에선 비워두어도 됨.
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_SENDER_KEY=

# ─── (Phase 6 예정) SMS ──────────────────────────────────
# NHN Cloud / Aligo 등 — provider 결정 후 추가.
# SMS_PROVIDER_API_KEY=
# SMS_SENDER_NUMBER=
