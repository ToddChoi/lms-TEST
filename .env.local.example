# =====================================================
# Ingrow LMS — 환경변수 예시 파일
# 실제 값은 .env.local 에 채워서 사용하세요. (.env.local 은 git 에 올라가지 않음)
# =====================================================

# ─── Supabase ─────────────────────────────────────────
# Supabase 대시보드 > Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── 앱 URL ──────────────────────────────────────────
# 로컬 개발: http://localhost:3000 (또는 3001)
# 운영: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 이메일 발송 (Phase 4 / Resend) ──────────────────
# https://resend.com 에서 API 키 발급
# 미설정 시 메일 발송이 자동으로 skip 처리됩니다 (앱은 정상 동작)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@your-domain.com

# ─── 카카오 알림톡 (Phase 4 선택, 추후) ──────────────
# 비즈메시지 사업자 등록 후 사용 가능. MVP 단계에서는 비워두어도 됩니다.
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_SENDER_KEY=

# ─── 결제 (향후 확장 — 현재 미사용) ──────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
