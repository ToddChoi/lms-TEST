{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "next build",
  "framework": "nextjs",
  "regions": ["icn1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-enrollments",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/offline/daily",
      "schedule": "0 16 * * *"
    }
  ]
}
